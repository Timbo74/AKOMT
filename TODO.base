views:
  - type: table
    name: View
    filters:
      and:
        - file.tags.contains("TODO")
    order:
      - file.name
      - file.folder
      - file.mtime
    sort:
      - property: formula.Untitled
        direction: DESC
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 158
